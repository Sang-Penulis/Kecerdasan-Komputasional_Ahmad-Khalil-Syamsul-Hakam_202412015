        "id": "387fd765"
      },
      "source": [
        "episodes_list = [1000, 2000, 5000]\n",
        "results = {}\n",
        "\n",
        "for num_episodes in episodes_list:\n",
        "    print(f\"\\n--- Melatih dengan {num_episodes} episode ---\")\n",
        "    trained_q_table, episode_rewards = train_q_agent(\n",
        "        env=env_taxi,\n",
        "        q_table_init=np.zeros((state_size_taxi, action_size_taxi)),\n",
        "        alpha=alpha_taxi,\n",
        "        gamma=gamma_taxi,\n",
        "        epsilon_init=epsilon_taxi,\n",
        "        epsilon_decay=epsilon_decay_taxi,\n",
        "        min_epsilon=min_epsilon_taxi,\n",
        "        episodes=num_episodes,\n",
        "        max_steps=max_steps_taxi,\n",
        "        report_interval=100\n",
        "    )\n",
        "    results[num_episodes] = {\n",
        "        'q_table': trained_q_table,\n",
        "        'rewards': episode_rewards\n",
        "    }"
      ],
